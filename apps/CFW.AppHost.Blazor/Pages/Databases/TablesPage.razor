@page "/databases/tables"
@using CFW.AppHost.Blazor.Pages.Databases.Components
@using CFW.AppHost.Blazor.ApiClient
@using Radzen
@using Radzen.Blazor
@using System.Text.Json
@inject IApiClient ApiClient
@inject DialogService DialogService
@inject NotificationService NotificationService

<div class="tables-page-container full-width">
    @* Main Content *@
    <div class="main-content">
        <div class="data-grid-container">
            <div class="grid-header">
                <div class="grid-actions">
                    <RadzenButton Text="Create New Table" Icon="add" ButtonStyle="ButtonStyle.Primary"
                    Click="@ShowCreateTableDialog" />
                </div>
            </div>

            @if (isLoading)
            {
                <div class="loading-container">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
                    <p>Loading data...</p>
                </div>
            }
            else if (hasError)
            {
                <div class="error-container">
                    <RadzenIcon Icon="error" Style="font-size: 3rem; color: #f44336; margin-bottom: 1rem;" />
                    <h3>Error loading data</h3>
                    <p>@errorMessage</p>
                    <RadzenButton Text="Retry" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Click="@LoadData" />
                </div>
            }
            else
            {
                <div class="content-grid">
                    @* Tables Tree Section *@
                    <div class="tables-section">
                        <div class="section-header">
                            <RadzenIcon Icon="folder" Style="margin-right: 0.5rem;" />
                            <h3>Tables List</h3>
                            <RadzenBadge Text="@filteredTables?.Count().ToString()" BadgeStyle="BadgeStyle.Success" />
                        </div>

                        @* Search Filter *@
                        <div class="search-filter-container">
                            <div class="search-input-wrapper">
                                <RadzenIcon Icon="search" class="search-icon" />
                                <RadzenTextBox @bind-Value="searchTerm" 
                                placeholder="Search tables..." 
                                class="search-input" 
                                @oninput="OnSearchInput" />
                                @if (!string.IsNullOrEmpty(searchTerm))
                                {
                                    <RadzenButton Icon="clear" 
                                    ButtonStyle="ButtonStyle.Light" 
                                    Size="ButtonSize.Small" 
                                    Click="ClearSearch"
                                    class="clear-search-btn" />
                                }
                            </div>
                        </div>

                        <div class="tree-container">
                            <RadzenTree Data="filteredTables" Style="height: 100%; width: 100%;" Change="@OnChange"
                            @bind-Value="@selection" class="custom-tree">
                                <RadzenTreeLevel TextProperty="@nameof(DatabaseTableViewModel.Name)" />
                            </RadzenTree>
                        </div>
                    </div>

                    @* Table Details Tabs Section *@
                    <div class="columns-section">
                        <div class="section-header">
                            <RadzenIcon Icon="table_chart" Style="margin-right: 0.5rem;" />
                            <h3>Table Details</h3>
                            @if (selectedTable != null)
                            {
                                <RadzenBadge Text="@selectedTable.Name" BadgeStyle="BadgeStyle.Primary" />
                            }
                        </div>
                        <div class="tabs-container">
                            @if (selectedTable != null)
                            {
                                <RadzenTabs RenderMode="TabRenderMode.Client" class="table-details-tabs">
                                    <Tabs>
                                        <RadzenTabsItem Text="Columns" Icon="view_column">
                                            <div class="tab-content">
                                                @if (selectedTable?.Columns?.Any() == true)
                                                {
                                                    <RadzenDataGrid Data="@selectedTable.Columns" AllowFiltering="true" AllowColumnResize="true"
                                                    AllowAlternatingRows="true" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="10"
                                                    AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                                                    LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single"
                                                    class="custom-data-grid">
                                                        <Columns>
                                                            <RadzenDataGridColumn Property="@nameof(DatabaseColumnViewModel.Name)" Filterable="false"
                                                            Title="Column Name" Frozen="true" Width="200px" TextAlign="TextAlign.Left">
                                                                <Template Context="column">
                                                                    <div class="column-name">
                                                                        <RadzenIcon Icon="view_column" Style="margin-right: 0.5rem; color: #666;" />
                                                                        <strong>@column.Name</strong>
                                                                    </div>
                                                                </Template>
                                                            </RadzenDataGridColumn>

                                                            <RadzenDataGridColumn Property="@nameof(DatabaseColumnViewModel.StoreType)"
                                                            Title="Data Type" Width="150px">
                                                                <Template Context="column">
                                                                    <RadzenBadge Text="@column.StoreType"
                                                                    BadgeStyle="@GetTypeBadgeStyle(column.StoreType ?? string.Empty)" />
                                                                </Template>
                                                            </RadzenDataGridColumn>

                                                            <RadzenDataGridColumn Property="@nameof(DatabaseColumnViewModel.IsNullable)"
                                                            Title="Nullable" Width="120px" TextAlign="TextAlign.Center">
                                                                <Template Context="column">
                                                                    @if (column.IsNullable)
                                                                    {
                                                                        <RadzenIcon Icon="check_circle" Style="color: #4caf50;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <RadzenIcon Icon="cancel" Style="color: #f44336;" />
                                                                    }
                                                                </Template>
                                                            </RadzenDataGridColumn>

                                                            <RadzenDataGridColumn Property="@nameof(DatabaseColumnViewModel.IsReadOnly)"
                                                            Title="Read Only" Width="100px" TextAlign="TextAlign.Center">
                                                                <Template Context="column">
                                                                    @if (column.IsReadOnly)
                                                                    {
                                                                        <RadzenIcon Icon="lock" Style="color: #ff9800;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <RadzenIcon Icon="lock_open" Style="color: #4caf50;" />
                                                                    }
                                                                </Template>
                                                            </RadzenDataGridColumn>

                                                            <RadzenDataGridColumn Property="@nameof(DatabaseColumnViewModel.DefaultValue)"
                                                            Title="Default Value" Width="150px">
                                                                <Template Context="column">
                                                                    @if (column.DefaultValue != null)
                                                                    {
                                                                        <RadzenBadge Text="@column.DefaultValue.ToString()" BadgeStyle="BadgeStyle.Light" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">-</span>
                                                                    }
                                                                </Template>
                                                            </RadzenDataGridColumn>
                                                        </Columns>
                                                    </RadzenDataGrid>
                                                }
                                                else
                                                {
                                                    <div class="empty-state">
                                                        <RadzenIcon Icon="view_column" Style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;" />
                                                        <h4>No columns found</h4>
                                                        <p>This table doesn't have any columns defined.</p>
                                                    </div>
                                                }
                                            </div>
                                        </RadzenTabsItem>

                                        <RadzenTabsItem Text="Data" Icon="table_rows">
                                            <div class="tab-content">
                                                <div class="data-tab-header">
                                                    <div class="data-actions">
                                                        <RadzenButton Text="@(isLoadingTableData ? "Loading..." : "Load Data")" 
                                                        Icon="@(isLoadingTableData ? "hourglass_empty" : "refresh")" 
                                                        ButtonStyle="ButtonStyle.Primary" 
                                                        Click="@LoadTableData" 
                                                        Disabled="@isLoadingTableData" />
                                                    </div>
                                                </div>

                                                @if (isLoadingTableData)
                                                {
                                                    <div class="loading-container">
                                                        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
                                                        <p>Loading table data...</p>
                                                    </div>
                                                }
                                                else if (tableData?.Any() == true)
                                                {
                                                    <RadzenDataGrid Data="@tableData" AllowFiltering="true" AllowColumnResize="true"
                                                    AllowAlternatingRows="true" FilterMode="FilterMode.Advanced" AllowSorting="true" 
                                                    PageSize="20" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" 
                                                    ShowPagingSummary="true" LogicalFilterOperator="LogicalFilterOperator.Or" 
                                                    class="table-data-grid">
                                                        <Columns>
                                                            @if (selectedTable?.Columns != null)
                                                            {
                                                                @foreach (var column in selectedTable.Columns)
                                                                {
                                                                    <RadzenDataGridColumn Title="@column.Name" Width="150px">
                                                                        <Template Context="row">
                                                                            @GetCellValue(row, column.Name)
                                                                        </Template>
                                                                    </RadzenDataGridColumn>
                                                                }
                                                            }
                                                        </Columns>
                                                    </RadzenDataGrid>
                                                }
                                                else if (hasError)
                                                {
                                                    <div class="error-container">
                                                        <RadzenIcon Icon="error" Style="font-size: 3rem; color: #f44336; margin-bottom: 1rem;" />
                                                        <h4>Error loading data</h4>
                                                        <p>@errorMessage</p>
                                                        <RadzenButton Text="Retry" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Click="@LoadTableData" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="empty-state">
                                                        <RadzenIcon Icon="table_rows" Style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;" />
                                                        <h4>No data loaded</h4>
                                                        <p>Click "Refresh Data" button above to load table data.</p>
                                                    </div>
                                                }
                                            </div>
                                        </RadzenTabsItem>
                                    </Tabs>
                                </RadzenTabs>
                            }
                            else
                            {
                                <div class="empty-state">
                                    <RadzenIcon Icon="table_chart" Style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;" />
                                    <h4>No table selected</h4>
                                    <p>Please select a table from the list on the left to view its details.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {

    IEnumerable<DatabaseTableViewModel>? databaseTableViewModels;
    IEnumerable<DatabaseTableViewModel>? filteredTables;
    object? selection;
    DatabaseTableViewModel? selectedTable;

    // Table Data
    List<Dictionary<string, object>> tableData = new List<Dictionary<string, object>>();

    // UI State
    bool isLoading = true;
    bool hasError = false;
    string errorMessage = string.Empty;
    string searchTerm = string.Empty;
    bool isLoadingTableData = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            hasError = false;
            errorMessage = string.Empty;
            StateHasChanged();

            var response = await ApiClient.TablesAsync(new Request2 { });

            databaseTableViewModels = response.Value;
            filteredTables = response.Value;
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


    void OnChange()
    {
        var newSelectedTable = selection as DatabaseTableViewModel;
        
        // Only proceed if the selection actually changed
        if (newSelectedTable?.Name == selectedTable?.Name)
            return;
            
        selectedTable = newSelectedTable;
        
        if (selectedTable != null)
        {
            // Clear table data when table is selected, but don't load automatically
            tableData.Clear();
            isLoadingTableData = false;
            hasError = false;
        }
        else
        {
            tableData.Clear();
            isLoadingTableData = false;
            hasError = false;
        }
    }

    private int GetColumnCount(DatabaseTableViewModel table)
    {
        return table.Columns?.Count ?? 0;
    }

    private BadgeStyle GetTypeBadgeStyle(string storeType)
    {
        if (string.IsNullOrEmpty(storeType))
            return BadgeStyle.Light;

        return storeType.ToLowerInvariant() switch
        {
            var type when type.Contains("int") || type.Contains("number") => BadgeStyle.Success,
            var type when type.Contains("string") || type.Contains("varchar") || type.Contains("text") => BadgeStyle.Info,
            var type when type.Contains("bool") || type.Contains("bit") => BadgeStyle.Warning,
            var type when type.Contains("date") || type.Contains("time") => BadgeStyle.Danger,
            var type when type.Contains("decimal") || type.Contains("float") || type.Contains("double") => BadgeStyle.Primary,
            _ => BadgeStyle.Light
        };
    }

    private async Task ShowCreateTableDialog()
    {
        var result = await DialogService.OpenAsync<CreateTableDialog>("Create New Table",
        new Dictionary<string, object>(),
        new DialogOptions()
        {
            Width = "900px",
            Height = "700px",
            Resizable = true,
            Draggable = true
        });

        //use "result is TableDefinitionViewModel tableDefinition" don't work here for some reason
        if (result != null && result is TableDefinitionViewModel)
        {
            try
            {
                var tableDefinition = result as TableDefinitionViewModel;
                await ApiClient.CreateTablesAsync(tableDefinition!);

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Success",
                    Detail = "Table created successfully",
                    Duration = 4000
                });

                // Reload data to show the new table
                await LoadData();
            }
            catch (Exception ex)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Failed to create table: {ex.Message}",
                    Duration = 4000
                });
            }
        }
    }

    private async Task LoadTableData()
    {
        if (selectedTable == null || isLoadingTableData) return;

        try
        {
            isLoadingTableData = true;
            hasError = false;
            StateHasChanged();

            // Load real data from API
            var dataResponse = await ApiClient.QueryAsync(selectedTable.Name);
            var data = dataResponse.Value;

            // Convert object data to Dictionary for DataGrid
            tableData = ConvertObjectToDictionaryList(data);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"Error loading table data: {ex.Message}";
            tableData = new List<Dictionary<string, object>>();
            StateHasChanged();
        }
        finally
        {
            isLoadingTableData = false;
        }
    }

    private List<Dictionary<string, object>> ConvertObjectToDictionaryList(ICollection<object> data)
    {
        var result = new List<Dictionary<string, object>>();
        
        // Get column names from selectedTable.Columns
        var columnNames = selectedTable?.Columns?.Select(c => c.Name).ToList() ?? new List<string>();
        
        foreach (var item in data)
        {
            var dictionary = new Dictionary<string, object>();
            
            // Initialize all columns with null values first
            foreach (var columnName in columnNames)
            {
                dictionary[columnName] = null;
            }
            
            // Fill with actual data from API response - only bind to existing keys
            if (item is JsonElement jsonElement)
            {
                foreach (var property in jsonElement.EnumerateObject())
                {
                    var value = ConvertJsonElementValue(property.Value);
                    
                    // Find matching column name (case-insensitive)
                    var matchingColumn = columnNames.FirstOrDefault(c => 
                        string.Equals(c, property.Name, StringComparison.OrdinalIgnoreCase));
                    
                    if (matchingColumn != null)
                    {
                        dictionary[matchingColumn] = value;
                    }
                }
            }
            else if (item is System.Collections.Generic.IDictionary<string, object> dict)
            {
                foreach (var kvp in dict)
                {
                    // Find matching column name (case-insensitive)
                    var matchingColumn = columnNames.FirstOrDefault(c => 
                        string.Equals(c, kvp.Key, StringComparison.OrdinalIgnoreCase));
                    
                    if (matchingColumn != null)
                    {
                        dictionary[matchingColumn] = kvp.Value;
                    }
                }
            }
            else
            {
                // Try to convert using reflection or JSON serialization
                var json = System.Text.Json.JsonSerializer.Serialize(item);
                var deserializedElement = System.Text.Json.JsonSerializer.Deserialize<JsonElement>(json);
                
                foreach (var property in deserializedElement.EnumerateObject())
                {
                    var value = ConvertJsonElementValue(property.Value);
                    
                    // Find matching column name (case-insensitive)
                    var matchingColumn = columnNames.FirstOrDefault(c => 
                        string.Equals(c, property.Name, StringComparison.OrdinalIgnoreCase));
                    
                    if (matchingColumn != null)
                    {
                        dictionary[matchingColumn] = value;
                    }
                }
            }
            
            result.Add(dictionary);
        }
        
        return result;
    }

    private string NormalizePropertyName(string propertyName)
    {
        // Convert to lowercase for case-insensitive matching
        return propertyName.ToLowerInvariant();
    }

    private object? ConvertJsonElementValue(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => element.GetString() ?? string.Empty,
            JsonValueKind.Number => element.TryGetInt32(out var intValue) ? intValue : 
                                   element.TryGetInt64(out var longValue) ? longValue :
                                   element.TryGetDecimal(out var decimalValue) ? decimalValue :
                                   element.GetDouble(),
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            JsonValueKind.Null => null,
            JsonValueKind.Array => element.EnumerateArray().Select(ConvertJsonElementValue).ToList(),
            JsonValueKind.Object => ConvertJsonElementToDictionary(element),
            _ => element.ToString()
        };
    }

    private Dictionary<string, object> ConvertJsonElementToDictionary(JsonElement element)
    {
        var dictionary = new Dictionary<string, object>();
        
        foreach (var property in element.EnumerateObject())
        {
            var value = ConvertJsonElementValue(property.Value);
            if (value != null)
            {
                dictionary[property.Name] = value;
            }
        }
        
        return dictionary;
    }



    private object GetCellValue(Dictionary<string, object> row, string columnName)
    {
        // Since Dictionary keys are now exactly from selectedTable.Columns,
        // we can directly access the value
        if (row.ContainsKey(columnName))
        {
            return FormatCellValue(row[columnName], columnName);
        }

        // Fallback: try case-insensitive search (should not be needed)
        var key = row.Keys.FirstOrDefault(k => 
            string.Equals(k, columnName, StringComparison.OrdinalIgnoreCase));
        
        if (key != null)
        {
            return FormatCellValue(row[key], columnName);
        }

        return "N/A";
    }

    private object FormatCellValue(object value, string columnName)
    {
        if (value == null)
            return "N/A";

        // Get column type information if available
        var column = selectedTable?.Columns?.FirstOrDefault(c => 
            string.Equals(c.Name, columnName, StringComparison.OrdinalIgnoreCase));

        var storeType = column?.StoreType?.ToLowerInvariant() ?? "";

        return value switch
        {
            DateTime dateTime => dateTime.ToString("yyyy-MM-dd HH:mm:ss"),
            DateTimeOffset dateTimeOffset => dateTimeOffset.ToString("yyyy-MM-dd HH:mm:ss"),
            bool boolValue => boolValue ? "✓" : "✗",
            decimal decimalValue when storeType.Contains("decimal") || storeType.Contains("money") => 
                decimalValue.ToString("N2"),
            double doubleValue when storeType.Contains("float") || storeType.Contains("double") => 
                doubleValue.ToString("N2"),
            int intValue when storeType.Contains("int") => intValue.ToString("N0"),
            long longValue when storeType.Contains("bigint") => longValue.ToString("N0"),
            string stringValue when stringValue.Length > 50 => 
                stringValue.Substring(0, 47) + "...",
            _ => value?.ToString() ?? "N/A"
        };
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
        FilterTables();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        FilterTables();
    }

    private void FilterTables()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            // Show all tables by default
            filteredTables = databaseTableViewModels;
        }
        else
        {
            // Filter tables based on search term
            var term = searchTerm.ToLowerInvariant();
            filteredTables = databaseTableViewModels?.Where(t =>
                t.Name.ToLowerInvariant().Contains(term) ||
                t.Columns.Any(c => c.Name.ToLowerInvariant().Contains(term) ||
                (c.StoreType?.ToLowerInvariant().Contains(term) ?? false))
            ) ?? Enumerable.Empty<DatabaseTableViewModel>();
        }

        StateHasChanged();
    }

}

<style>
    .tables-page-container {
        padding: 0;
        max-width: 100%;
        margin: 0;
        background: transparent;
        min-height: auto;
        width: 100%;
    }

    .tables-page-container.full-width {
        padding: 0;
        background: var(--background-color);
        min-height: calc(100vh - var(--header-height));
        width: 100%;
        max-width: 100%;
    }

    /* Override MainLayout constraints */
    .app-main.full-width .main-content {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
    }

    /* Enhanced width for data grids on large screens */
    @@media (min-width: 1600px) {
        .app-main.full-width .main-content {
            max-width: 100% !important;
        }
    }

    @@media (min-width: 2000px) {
        .app-main.full-width .main-content {
            max-width: 100% !important;
        }
    }


    .main-content {
        background: transparent;
        border-radius: 0;
        box-shadow: none;
        overflow: visible;
        border: none;
        width: 100%;
        max-width: 100%;
    }

    .data-grid-container {
        background: var(--surface-color);
        border-radius: 0;
        box-shadow: none;
        overflow: hidden;
        border: none;
        width: 100%;
        max-width: 100%;
    }

    .grid-header {
        padding: 1.5rem;
        border-bottom: 1px solid var(--border-light);
        margin-bottom: 0;
    }

    .grid-actions {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 1rem;
    }

    .loading-container,
    .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        text-align: center;
        min-height: 400px;
    }

    .loading-container p,
    .error-container p {
        margin-top: 1rem;
        color: var(--text-secondary);
        font-size: 1.1rem;
    }

    .error-container h3 {
        color: var(--error-color);
        margin-bottom: 0.5rem;
        font-size: 1.5rem;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 350px 1fr;
        height: 600px;
        gap: 0;
    }

    .tables-section,
    .columns-section {
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--border-color);
    }

    .columns-section {
        border-right: none;
    }

    .section-header {
        display: flex;
        align-items: center;
        padding: 1.25rem 1.5rem;
        background: linear-gradient(90deg, var(--surface-variant) 0%, #f8f9fa 100%);
        border-bottom: 1px solid var(--border-color);
        gap: 0.75rem;
    }

    .section-header h3 {
        margin: 0;
        color: var(--text-primary);
        font-weight: 600;
        font-size: 1.1rem;
    }

    .section-header .rz-icon {
        color: var(--primary-color);
        font-size: 1.2rem;
    }

    .tree-container,
    .data-grid-container {
        flex: 1;
        padding: 1.5rem;
        overflow: auto;
    }

    /* Search Filter Styles */
    .search-filter-container {
        padding: 1rem 1.5rem 0.5rem 1.5rem;
        border-bottom: 1px solid var(--border-light);
        background: var(--surface-variant);
    }

    .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        max-width: 100%;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        color: var(--text-secondary);
        z-index: 1;
        font-size: 1rem;
    }

    .search-input {
        padding-left: 40px !important;
        padding-right: 40px !important;
        border-radius: var(--border-radius);
        border: 2px solid var(--border-color);
        transition: all 0.3s ease;
        font-size: 0.9rem;
        height: 40px;
        background: var(--surface-color);
        width: 100%;
    }

    .search-input:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.1);
        outline: none;
    }

    .clear-search-btn {
        position: absolute;
        right: 8px;
        z-index: 1;
        opacity: 0.7;
        transition: opacity 0.2s ease;
        padding: 4px !important;
        min-width: 32px !important;
        height: 32px !important;
    }

    .clear-search-btn:hover {
        opacity: 1;
    }

    .custom-tree {
        border: none;
    }

    .custom-tree .rz-tree-item {
        border-radius: var(--border-radius);
        margin: 2px 0;
        transition: all 0.2s ease;
        padding: 0.5rem 0.75rem;
        position: relative;
    }

    .custom-tree .rz-tree-item:hover {
        background-color: var(--surface-variant);
        transform: translateX(4px);
    }

    .custom-tree .rz-tree-item::before {
        content: "📊";
        margin-right: 0.5rem;
        font-size: 1rem;
    }

    .custom-tree .rz-tree-item-text {
        font-weight: 500;
        color: var(--text-primary);
        font-size: 0.95rem;
    }

    /* Enhanced Table Item Styles */
