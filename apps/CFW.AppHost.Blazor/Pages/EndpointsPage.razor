                    }
                }

                @@media(max - width: 480px) {
        .grid-header {
            padding: 0.75rem;
        }
    }
</style>

@code {

    private IEnumerable<Value6> endpoints = new List<Value6>();
    private int totalCount;
    private EndpointFilter filterModel = new();
    private List<string> methods = new() { "GET", "POST", "PUT", "DELETE" };
    private List<object> authOptions = new() 
    { 
        new { Text = "All", Value = (bool?)null },
        new { Text = "Required", Value = (bool?)true },
        new { Text = "Not Required", Value = (bool?)false }
    };
    bool IDVisible = false;

    public class EndpointFilter
    {
        public string SearchTerm { get; set; } = "";
        public string? Method { get; set; }
        public bool? IsAuthenticationRequired { get; set; }
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadEndpointsAsync(new LoadDataArgs());
    }

    private async Task LoadEndpointsAsync(LoadDataArgs args)
    {
        try
        {
            // Build OData filter string
            var filterParts = new List<string>();
            
            if (!string.IsNullOrEmpty(filterModel.SearchTerm))
            {
                filterParts.Add($"(contains(tolower(Path), tolower('{filterModel.SearchTerm}')) or contains(tolower(Description), tolower('{filterModel.SearchTerm}')))");
            }

            if (!string.IsNullOrEmpty(filterModel.Method))
            {
                // Convert method string to enum value for OData filter
                var methodValue = filterModel.Method.ToUpper() switch
                {
                    "GET" => "0",
                    "POST" => "1", 
                    "PUT" => "2",
                    "DELETE" => "3",
                    _ => filterModel.Method
                };
                filterParts.Add($"Method eq {methodValue}");
            }

            if (filterModel.IsAuthenticationRequired.HasValue)
            {
                filterParts.Add($"IsAuthenticationRequired eq {filterModel.IsAuthenticationRequired.Value.ToString().ToLower()}");
            }

            var filter = filterParts.Any() ? string.Join(" and ", filterParts) : null;

            // Call API with OData parameters
            var endpointsResp = await ApiClient.EndpointsAsync(
                filter: filter,
                top: args.Top,
                skip: args.Skip,
                orderby: args.OrderBy,
                count: true
            );

            endpoints = endpointsResp.Value ?? new List<Value6>();
            totalCount = (int)(endpointsResp.OdataCount ?? 0);

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // Handle error if needed
            Console.WriteLine($"Error loading endpoints: {ex.Message}");
            endpoints = new List<Value6>();
            totalCount = 0;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnFilterChanged()
    {
        await LoadEndpointsAsync(new LoadDataArgs());
    }

    private async Task ClearFilters()
    {
        filterModel = new EndpointFilter();
        await LoadEndpointsAsync(new LoadDataArgs());
    }

    private async Task AddEndpoint()
    {
        var result = await DialogService.OpenAsync<EndpointCreate>("Create Endpoint",
        new Dictionary<string, object>(),
        new DialogOptions()
        {
            Width = "80vw",
            Height = "80vh",
            Resizable = true,
            Draggable = true,
            CloseDialogOnOverlayClick = false
        });
    }
}